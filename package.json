{
   "name": "mensa-new-backend",
   "version": "1.0.0",
   "main": "index.js",
   "scripts": {
      "build": "tsc",
      "start": "ts-node src/index.ts",
      "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
      "lint": "eslint 'src/**/*.ts'",
      "typeorm": "typeorm-ts-node-commonjs",
      "typeorm:generate": "npx typeorm-ts-node-esm migration:generate -d src/db/dataSourceLocal.ts",
      "typeorm:migrate": "npx typeorm-ts-node-esm migration:run -d src/db/dataSourceLocal.ts"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "description": "",
   "devDependencies": {
      "@types/express": "^5.0.3",
      "@types/node": "^16.11.10",
      "dotenv": "^16.5.0",
      "eslint": "^9.28.0",
      "express": "^5.1.0",
      "install": "^0.13.0",
      "nodemon": "^3.1.10",
      "npm": "^10.9.2",
      "prettier": "^3.5.3",
      "ts-node": "^10.9.1",
      "typescript": "4.5.2"
   },
   "dependencies": {
      "pg": "^8.16.0",
      "reflect-metadata": "^0.1.14",
      "typeorm": "^0.3.21"
   }
}
